# ===== Bot sozlamalari =====
BOT_TOKEN=123456789:AAExampleTokenHere
BOT_USERNAME=your_bot_username

# ===== Superadminlar (vergul bilan ajratilgan Telegram ID lar) =====
SUPERADMIN_IDS=111111111,222222222

# ===== Webhook (Railway) =====
USE_WEBHOOK=true
WEBHOOK_HOST=https://your-app.up.railway.app
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ===== PostgreSQL (Railway avtomatik beradi) =====
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway
SYNC_DATABASE_URL=postgresql://user:password@host:5432/railway

# ===== Backup =====
BACKUP_CHANNEL_ID=-1001234567890
BACKUP_INTERVAL_HOURS=24

# ===== Boshqa =====
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent
CAPTCHA_MAX_ATTEMPTS=3
CAPTCHA_BLOCK_SECONDS=30
SUBSCRIPTION_RECHECK_INTERVAL_HOURS=1
